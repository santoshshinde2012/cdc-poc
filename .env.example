# Optional overrides. Copy to .env, docker compose reads it automatically.
# Host port mapped to the Postgres container (default 55432).
POSTGRES_PORT=55432

# Fixed on purpose, change them only together:
#   receiver port 18080     run.sh and debezium/conf/application.properties (debezium.sink.http.url)
#   database credentials    docker-compose.yml and debezium/conf/application.properties (local demo only)
